configuration {
	modi: "drun,run,window";
	show-icons: false;
	display-drun: "󰆌 ";
	display-run: " ";
	display-window: "󰹑 ";

  kb-remove-to-eol: "";
  kb-accept-entry: "";

  kb-row-up: "Up,Control+k";
  kb-row-down: "Down,Control+j";
  kb-accept-entry: "Return";
  //kb-mode-previous: "h";
  //kb-mode-next: "l";
}

* {
	base00: #2e3440FF;
	base01: #3b4252FF;
	base02: #434c5eFF;
	base03: #4c566aFF;
	base04: #e3f4ffFF;
	base07: #c7faffFF;
	base08: #9ad4fbFF;
	base09: #386fcdFF;
	base0B: #a3f1fdFF;
	base0C: #5a8fb8FF;
	base0D: #def9ffFF;
	base0E: #eec6f5FF;
	base0F: #c8f8f7FF;

  font: "InconsolataLGC Nerd Font 16";

	transparency: transparent;
}

window {
	location: center;
	anchor: center;
	transparency: "real";
	fullscreen: false;
	width: 450px;
	x-offset: 0px;
	y-offset: 0px;

	enabled: true;
	margin: 0px;
	padding: 0px;
	border: 4px solid;
	border-radius: 2px;
	border-color: @base08;
	cursor: "default";
	background-color: @base00;
}

mainbox {
	enabled: true;
	spacing: 10px;
	margin: 0px;
	padding: 30px;
	background-color: @transparency;
	children: [ "inputbar", "message", "listview", "mode-switcher" ];
}

inputbar {
	enabled: true;
	spacing: 10px;
	margin: 0px;
  padding: 8px;
	border: 2px 2px 2px 2px;
	border-radius: 2px;
	border-color: @base0E;
	background-color: @base03;
	text-color: @base04;
	children: [ "entry" ];
}

prompt {
	enabled: true;
	background-color: inherit;
	text-color: inherit;
}

entry {
	enabled: true;
	padding: 0px;
	background-color: inherit;
	text-color: inherit;
	placeholder: " :";
	placeholder-color: @base04;
}

listview {
	enabled: true;
	columns: 1;
	lines: 4;
	cycle: true;
	dynamic: true;
	scrollbar: false;
	layout: vertical;
	reverse: false;
	fixed-height: true;
	fixed-columns: true;
	spacing: 3px;
	cursor: inherit;
	background-color: @transparency;
	text-color: @base0D;
}

scrollbar {
	handle-width: 5px;
	handle-color: @base0E;
	border-radius: 4px;
	background-color: @base03;
}

element {
  enabled: true;
  spacing: 10px;
  margin: 0px;
  padding: 6px;
  border-radius: 0px;
  background-color: @transparency;
  text-color: @base0C;
  cursor: inherit;
}

element normal.normal,
element alternate.normal {
	background-color: @base04;
	text-color: @base00;
}

element normal.urgent,
element alternate.urgent,
element selected.active {
	background-color: @base00;
	text-color: @base07;
	border: 0px 2px 2px 0px;
	border-radius: 4px;
	border-color: @base0E;
}

element normal.active,
element alternate.active,
element selected.urgent {
	background-color: @base04;
	text-color: @base00;
	border: 0px 2px 2px 2px;
	border-color: @base0E;
}

element selected.normal {
	background-color: @base03;
	text-color: @base07;
}

element-icon {
	background-color: @transparency;
	text-color: inherit;
	size: 24px;
	cursor: inherit;
}

element-text {
	background-color: @transparency;
	text-color: inherit;
	cursor: inherit;
	vertical-align: 0.5;
	horizontal-align: 0.0;
}

mode-switcher {
	enabled: true;
	spacing: 5px;
	margin: 0px;
	padding: 0px 50px;
	background-color: @base00;
	text-color: @base04;
}

button {
	padding: 10px;
	border-radius: 2px;
	background-color: @base00;
	text-color: @base08;
	cursor: inherit;
}

button selected {
	background-color: @base03;
	text-color: @base07;
	border: 0px 2px 2px 0px;
	border-radius: 4px;
	border-color: @base0E;
}

message {
	enabled: true;
	margin: 0px;
	padding: 10px;
	border-radius: 0px;
	background-color: @base00;
	text-color: @base04;
}

textbox {
	background-color: @base02;
	text-color: @base0D;
	vertical-align: 0.5;
	horizontal-align: 0.0;
	highlight: none;
	placeholder-color: @base08;
	blink: true;
	markup: true;
}

error-message {
	padding: 30px;
	background-color: @base0E;
	text-color: @base09;
}
